# Скопируй этот файл в .env (для запуска на компьютере). На Render эти значения вводятся в Environment.
BOT_TOKEN=сюда_токен_от_BotFather
GEMINI_API_KEY=сюда_ключ_из_Google_AI_Studio
# Telegram ID (узнай командой /id у бота). Можно несколько через запятую: 111,222
OWNER_CHAT_ID=
CITY=Bishkek
TIMEZONE=Asia/Bishkek
MORNING_TIME=05:00
LUNCH_TIME=13:00
GEMINI_MODEL=gemini-2.5-flash
# Строка подключения к Neon (чтобы подписчики не пропадали). Без неё работает временный SQLite
DATABASE_URL=
